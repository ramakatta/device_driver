                         LINUX KERNEL
                              │
             ┌────────────────┴────────────────┐
             │                                 │
             ▼                                 ▼
      ┌───────────────┐                 ┌───────────────┐
      │    TRACER     │                 │    TRACEE     │
      │   (Parent)    │                 │    (Child)    │
      └───────┬───────┘                 └───────┬───────┘
              │                                 │
              │ fork()                          │
              │────────────────────────────────►│
              │                                 │
              │                                 │
              │                         PTRACE_TRACEME
              │                                 │
              │                                 │
              │                         execl("./tracee")
              │                                 │
              │                                 ▼
              │                              main()
              │                                 │
              │                                 ▼
              │                           abc(local_abc)
              │                                 │
              │                                 ▼
              │                      print address of local_abc
              │                                 │
              │                                 ▼
              │                            while(1)
              │                                 │
              │                                 │
              │       waitpid(tracee_pid)       │
              │◄────────────────────────────────┤
              │                                 │
              │     "Wait until tracee stops"   │
              │                                 │
              │                                 │
              │       PTRACE_GETREGS            │
              │────────────────────────────────►│
              │                                 │
              │◄──────── RIP, RSP, registers ───┤
              │                                 │
              │                                 │
              │       PTRACE_CONT               │
              │────────────────────────────────►│
              │                                 │
              │                        tracee continues
              │                                 │
              │                                 │
              │       waitpid(tracee_pid)       │
              │◄────────────────────────────────┤
              │                                 │
              │       tracee stops again        │
              │                                 │
              │                                 │
              │   User enters address           │
              │                                 │
              │       PTRACE_PEEKTEXT           │
              │────────────────────────────────►│
              │                                 │
              │◄────── data at address ─────────┤
              │                                 │
              │                                 │
              │   PTRACE_POKETEXT               │
              │────────────────────────────────►│
              │                                 │
              │              WRITE 0x678910     │
              │                                 │
              │                                 │
              │       PTRACE_PEEKTEXT           │
              │────────────────────────────────►│
              │                                 │
              │◄────── 0x678910 ───────────────┤
              │                                 │
              │                                 │
              │       PTRACE_CONT               │
              │────────────────────────────────►│
              │                                 │
              │                                 ▼
              │                            continue
              │                                 │
              ▼                                 ▼
